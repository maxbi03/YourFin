# Copie ce fichier en .env.local (déjà ignoré par git) pour activer le compte optionnel.
# Sans ces variables, YourFin fonctionne normalement en local uniquement — rien n'est cassé.
#
# Où trouver ces valeurs : Dashboard Supabase → ton projet → Project Settings → API.
# La clé "anon" est publique par conception (elle est envoyée au navigateur) ; la protection
# vient des policies Row Level Security définies dans supabase/migrations/0001_init.sql, pas
# du secret de cette clé.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
